// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User{
    id                  String    @id     @default(uuid()) 
    username            String
    password            String
    Folder Folder[]
    File File[]
}

model Folder{
    id                  String    @id     @default(uuid()) 
    title               String
    createdAt           DateTime       @default(now())
    user_id             String
    ParentFolderId      String? 

    childrenFolder  Folder[]  @relation("parent")
    parent          Folder?  @relation("parent" , fields: [ParentFolderId] , references: [id])
    Files           File[]
    owner           User    @relation(fields: [user_id] , references: [id])

}

model File{
    id                  String    @id     @default(uuid()) 
    title               String
    user_id             String
    createdAt           DateTime       @default(now())
    ParentFolderId      String?
    url                 String
    // type            FileType    

    parent          Folder?  @relation(fields: [ParentFolderId] , references: [id])    
    owner           User    @relation(fields: [user_id] , references: [id])
}

enum FileType{
    PDF
    VIDEO
}