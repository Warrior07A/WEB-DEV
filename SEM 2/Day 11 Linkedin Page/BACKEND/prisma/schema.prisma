generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
    id          Int         @id  @default(autoincrement())
    name        String      
    email       String      @unique
    password    String      
    secretrole  String?      @default("user")
    subheading  String?
    phone       Int?     
    coverpic    String?
    ppic        String?
    Location    String?
    About       String?
    Posts       Posts[]

}

model Posts{
    id          Int         @id  @default(autoincrement())
    user_id     Int 
    CreatedAt   BigInt
    content     String
    contentimg   String?
    contentvdo  String?
    owner       User @relation(fields: [user_id] , references: [id])
}