// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Users{
    id                Int   @id     @default(autoincrement()) 
    username            String
    password            String
    Folder Folder[]
    File File[]
}

model Folder{
    id                Int   @id     @default(autoincrement()) 
    title               String
    parentFolderid      Int?           
    userId              Int
    createdAt           DateTime

    parent              Folder?     @relation(name : "self-relation" , fields: [parentFolderid] , references: [id])
    childrenFolder      Folder[]    @relation("self-relation")    
    childrenFiles       File[]
    owner               Users        @relation(fields: [userId] , references: [id])
}

model File{
    id                  Int   @id     @default(autoincrement()) 
    title               String
    type                FileType
    url                 String
    userId              Int
    parentFolderId      Int?
    createdAt           DateTime
    
    parent              Folder?         @relation(fields: [parentFolderId] , references: [id])
    owner               Users        @relation(fields: [userId] , references: [id])
}

enum FileType{
    PDF
    VIDEO
}