// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Blog      Blog[]
}

model Blog {
  id      Int    @id @default(autoincrement())
  title   String
  content String
  user_id Int

  blog User @relation(fields: [user_id], references: [id])
}
